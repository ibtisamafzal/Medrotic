            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPatientDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPatientDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPatientDto"
              }
            }
          }
        },
