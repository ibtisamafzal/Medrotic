{
    "version": 2,
    "public": true,
    "headers": [
      {
        "source": "/og-image.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Content-Type",
            "value": "image/png"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/((?!.*\\.(png|jpg|jpeg|gif|svg|ico|css|js|woff|woff2|ttf|eot|json|xml|txt|pdf|zip)).*)",
        "destination": "/api/index"
      }
    ],
    "functions": {
      "api/index.js": {
        "includeFiles": "dist/frontend/**"
      }
    }
  }